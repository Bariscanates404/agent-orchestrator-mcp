# Agent Orchestrator MCP - Environment Variables

# Watcher HTTP server port (default: 4317)
ORCHESTRATOR_WATCHER_PORT=4317

# Default backend for worker tasks: claude | codex (default: claude)
ORCHESTRATOR_DEFAULT_BACKEND=claude

# Default backend for lead (planner) agent: claude | codex (default: codex)
ORCHESTRATOR_DEFAULT_LEAD=codex

# Fallback backend when Codex is unavailable: claude | codex (default: claude)
ORCHESTRATOR_CODEX_FALLBACK=claude

# Project root directory (auto-detected from git, override if needed)
# TEAMLEAD_REPO_ROOT=/path/to/your/project

# State/data directory (default: ~/.codex/agent-orchestrator)
# TEAMLEAD_STATE_ROOT=~/.codex/agent-orchestrator

# Lead run polling interval in ms (default: 2000)
# LEAD_RUN_POLL_MS=2000

# Worker task timeout in ms (default: 600000 = 10min)
# LEAD_WORKER_TIMEOUT_MS=600000
